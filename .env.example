# SOASA Election System - Environment Variables
# Copy this file to .env.local for local development
# Add these to Vercel Environment Variables for production

# ============================================
# Supabase Configuration
# ============================================
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# Security & Authentication
# ============================================
# Generate a strong random 32+ character string for JWT signing
# Example: openssl rand -base64 32
JWT_SECRET=your-random-32-character-jwt-secret-here

# Admin secret for electoral committee (full access)
# Use a long, random, secure password (min 20 characters)
ADMIN_SECRET=your-long-random-admin-secret-here

# Electoral Commissioner password (dashboard access only)
# Separate from ADMIN_SECRET for better security
EC_DASHBOARD_PASSWORD=your-electoral-commissioner-password-here

# ============================================
# Optional Configuration
# ============================================
# Node environment (development, production, test)
NODE_ENV=production

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file:
#    cp .env.example .env.local
#
# 2. Fill in your actual values (never commit .env.local to git!)
#
# 3. For Vercel deployment:
#    - Go to Vercel Dashboard → Your Project → Settings → Environment Variables
#    - Add each variable above (except NODE_ENV, Vercel sets this automatically)
#    - Apply to: Production, Preview, and Development
#
# 4. Generate secure secrets:
#    JWT_SECRET:        openssl rand -base64 32
#    ADMIN_SECRET:      openssl rand -base64 32
#    EC_DASHBOARD_PWD:  Use a memorable but strong passphrase
#
# ============================================
# SECURITY WARNINGS
# ============================================
# - NEVER commit .env.local or .env files to git
# - NEVER share SUPABASE_SERVICE_ROLE_KEY publicly
# - NEVER hardcode secrets in your source code
# - Use strong, unique passwords for production
# - Store backup copies of secrets securely (password manager)
